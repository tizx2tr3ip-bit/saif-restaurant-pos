<odoo>
  <template id="login_without_promotion" inherit_id="web.login_layout" name="Login without promotion">
    <xpath expr="//a[@href='https://www.odoo.com?utm_source=db&amp;utm_medium=auth']" position="replace"/>
    <xpath expr="//div[@t-if='not disable_footer']" position="attributes">
      <attribute name="t-if">not disable_footer and not disable_database_manager</attribute>
    </xpath>
  </template>
</odoo>
